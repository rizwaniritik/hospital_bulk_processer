# ── External Hospital API ───────────────────────────────────────────────────
# Base URL for the deployed Hospital Directory API
HOSPITAL_API_BASE_URL=https://hospital-directory.onrender.com

# Timeout in seconds for each HTTP call to the external API
API_TIMEOUT_SECONDS=30

# ── Business Rules ──────────────────────────────────────────────────────────
# Maximum number of hospitals allowed in a single CSV upload
MAX_CSV_ROWS=20

# How many hospital create requests to fire in parallel
MAX_CONCURRENT_REQUESTS=5

# ── Server ──────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# Set to true for hot-reload during local development
DEBUG=false

